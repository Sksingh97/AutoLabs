<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appliance_item_root"
    android:layout_width="68dp"
    android:layout_height="wrap_content"
    android:layout_margin="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp"
        android:background="@drawable/widget_item_bg"
        android:gravity="center">

        <!-- Appliance icon -->
        <ImageView
            android:id="@+id/appliance_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/appliance_icon_placeholder"
            android:contentDescription="Appliance" />

        <!-- Appliance name -->
        <TextView
            android:id="@+id/appliance_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Status indicator (on/off dot) -->
    <ImageView
        android:id="@+id/status_indicator"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:src="@drawable/status_off"
        android:contentDescription="Status" />

    <!-- Favorite star icon -->
    <TextView
        android:id="@+id/favorite_star"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="★"
        android:textColor="#FFD700"
        android:textSize="16sp"
        android:layout_gravity="start|top"
        android:layout_marginStart="5dp"
        android:layout_marginTop="5dp" />

</FrameLayout>
